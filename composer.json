{
  "name": "klasmeyt/agritrace",
  "description": "AgriTrace+ Livestock System",
  "type": "project",
  "require": {
    "php": "^8.1",
    "supabase/supabase-php": "^1.1"
  },
  "require-dev": {},
  "autoload": {
    "psr-4": {}
  },
  "scripts": {
    "post-install-cmd": [
      "@auto-scripts"
    ],
    "auto-scripts": []
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "minimum-stability": "stable"
}